---
// Site footer
const COLS: [string, [string, string][]][] = [
  ["About", [["About INDI", "/about.html"], ["Features", "/about/features.html"], ["Ekos", "/about/ekos.html"], ["Clients", "/about/clients.html"], ["Contributors", "/about/contributors.html"], ["News", "/about/news.html"]]],
  ["Develop", [["Developer manual", "/develop/developer-manual.html"], ["API reference", "/api/index.html"], ["Technical docs", "https://docs.indilib.org"], ["Python bindings", "/tutorials/indi-python-programming.html"], ["Source code", "https://github.com/indilib/indi"]]],
  ["Use INDI", [["Download", "/download.html"], ["Tutorials", "/tutorials.html"], ["Drivers", "https://drivers.indilib.org"], ["Gallery", "/support/gallery.html"]]],
  ["Support", [["FAQ", "/support/faq.html"], ["Forum", "https://forum.indilib.org"], ["Submit logs", "/support/logs-submission.html"], ["Report a bug", "https://github.com/indilib/indi/issues"]]],
];
---
<footer class="site">
  <div class="wrap">
    <div class="about">
      <a class="brand" href="/"><img src="/img/logo.webp" alt=""><span><b>INDI</b><small>Open Astronomy Instrumentation</small></span></a>
      <p>Powered by the community, for the community. INDI is free software under the LGPL v2 license.</p>
    </div>
    {COLS.map(([head, links]) => (
      <div><h4>{head}</h4><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></div>
    ))}
  </div>
</footer>
<div class="legal"><div class="wrap"><span>© 2003 - {new Date().getFullYear()} INDI Library</span><a href="https://github.com/indilib/indi-website">Edit this site on GitHub</a></div></div>
