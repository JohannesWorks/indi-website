<script>
  // ---------- Mobile menu ----------
  var burger = document.getElementById("burger"), nav = document.getElementById("nav");
  burger.addEventListener("click", function () { var open = nav.classList.toggle("open"); burger.setAttribute("aria-expanded", open); });
  nav.addEventListener("click", function (e) { if (e.target.tagName === "A") { nav.classList.remove("open"); burger.setAttribute("aria-expanded", "false"); } });
</script>
