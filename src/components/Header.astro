<header class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="INDI home">
      <img src="/img/logo.webp" alt="">
      <span><b>INDI</b><small>Open Astronomy Instrumentation</small></span>
    </a>
    <nav class="main" id="nav" aria-label="Main">
