---
import Base from "../layouts/Base.astro";
import HowItWorks from "../components/HowItWorks.astro";
import "../styles/home.css";
---
<Base title="INDI Library" description="INDI is open source software that connects astronomy programs to observatory hardware: mounts, cameras, focusers, domes and more.">
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">Open source astronomy software</p>
          <h1>Control any telescope, camera or observatory. <span>From anywhere.</span></h1>
          <p class="lede">INDI connects your astronomy software to your equipment. It runs a single backyard telescope or a group of remote observatories, over any network, with no extra software.</p>
          <div class="cta">
            <a class="btn primary" href="#install">Install INDI</a>
            <a class="btn ghost" href="https://drivers.indilib.org">Find your driver</a>
          </div>
          <div class="facts">
            <span><b>Free</b> under LGPL v2</span>
            <span><b>Linux · macOS · Windows*</b></span>
            <span><b>27</b> compatible clients</span>
          </div>
        </div>
        <div class="photo">
          <img src="/img/img-6738.webp" alt="A community member's setup on a deck: a refractor and Raspberry Pis running StellarMate, controlled from a laptop with KStars">
          <span class="chip"><i></i>Mount · Tracking</span>
          <div class="capture">
            <img src="/img/m-45.webp" alt="">
            <div><small>Captured with INDI</small><b>M45 Pleiades</b><span>RedCat51 · 533MC · 10×300s</span></div>
          </div>
        </div>
      </div>

      <nav class="quick" aria-label="Start here">
        <a href="#install"><svg viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"/></svg><b>Download</b><span>Ubuntu, Raspberry Pi, Fedora, Arch, macOS</span></a>
        <a href="https://drivers.indilib.org"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M8 7l1.5-2h5L16 7"/></svg><b>Drivers</b><span>Mounts, cameras, focusers, domes and more</span></a>
        <a href="/develop.html"><svg viewBox="0 0 24 24"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></svg><b>Develop</b><span>API, developer manual and Python bindings</span></a>
        <a href="https://forum.indilib.org"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4Z"/></svg><b>Forum</b><span>Ask the community at forum.indilib.org</span></a>
      </nav>
    </div>
  </section>

  <div class="sponsor"><div class="wrap"><span>INDI is sponsored by</span><a href="https://www.touptek-astro.com/">Touptek Astro</a><span>· Become a sponsor through <a href="#community">Support INDI</a></span></div></div>

  <section id="news">
    <div class="wrap">
      <div class="sec-head split">
        <div><p class="eyebrow">What's new</p><h2>Recent drivers and features</h2></div>
        <a class="more" href="/tutorials.html">All tutorials</a>
      </div>
      <div class="news">
        <a class="lead-story" href="/tutorials/smart-telescopes-alpaca.html">
          <img src="/img/alpaca-support.webp" alt="KStars on a laptop commanding a ZWO Seestar through INDI and Alpaca">
          <span class="tagline">Smart telescopes</span>
          <h3>Alpaca support in INDI</h3>
          <p>INDI now supports smart telescopes and Alpaca-native hardware in two ways: dedicated drivers for devices like the Celestron Origin, and a flexible Alpaca bridge for devices like the ZWO Seestar.</p>
        </a>
        <div class="story-list">
          <a class="story" href="/tutorials/pifinder.html">
            <img src="/img/pifinder.webp" alt="">
            <div><span class="tagline">Open source finder</span><h3>PiFinder</h3><p>A Raspberry Pi finder that uses a camera, star databases, an IMU and GPS to work out where the telescope points.</p></div>
          </a>
          <a class="story" href="/tutorials/power-controllers.html">
            <img src="/img/indi-power-controllers.webp" alt="">
            <div><span class="tagline">Power interface</span><h3>Supported power controllers</h3><p>One standard power interface, from a Pegasus hub to a DIY controller.</p></div>
          </a>
          <a class="story" href="/tutorials/pocketscope.html">
            <img src="/img/pocketscope-indi-server.webp" alt="">
            <div><span class="tagline">Android</span><h3>PocketScope</h3><p>Turn an Android phone into an INDI camera and motorized focuser.</p></div>
          </a>
          <a class="story" href="/tutorials/indi-safety-monitor.html">
            <img src="/img/safety-monitor.webp" alt="">
            <div><span class="tagline">Observatory</span><h3>Safety Monitor</h3><p>Combines weather, power and cloud sensors into one clear safety status.</p></div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">INDI architecture</p>
        <h2>How INDI works</h2>
        <p class="lede">Each device has a driver. The INDI server offers all drivers on one network port, and any INDI client can use them, on the same computer or from anywhere on the network.</p>
      </div>

      <HowItWorks />

      <div class="pillars">
        <div class="pillar"><h3>Open source</h3><p>Anyone can contribute and reuse it under the commercial-friendly LGPL v2 license.</p></div>
        <div class="pillar"><h3>Cross platform</h3><p>Runs on Linux and macOS, with Windows support.</p></div>
        <div class="pillar"><h3>Client agnostic</h3><p>Drivers are written once for all clients. Clients need no update when a driver gains features.</p></div>
        <div class="pillar"><h3>Distributed control</h3><p>Talk to devices on the same machine or across the network, in the same way.</p></div>
      </div>
    </div>
  </section>

  <section id="devices">
    <div class="wrap">
      <div class="sec-head split">
        <div><p class="eyebrow">Supported devices</p><h2>Find the driver for your gear</h2></div>
        <a class="more" href="https://drivers.indilib.org">Full driver catalog</a>
      </div>
      <div class="devices">
        <a class="dev" href="https://drivers.indilib.org/mounts"><svg viewBox="0 0 24 24"><path d="M5 20h14M12 20v-6M8 20l4-6 4 6"/><rect x="6" y="5" width="12" height="5" rx="1" transform="rotate(-20 12 7.5)"/></svg>Mounts</a>
        <a class="dev" href="https://drivers.indilib.org/cameras"><svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="12" rx="2"/><circle cx="12" cy="13" r="3.5"/><path d="M8 7l1.5-2h5L16 7"/></svg>Cameras</a>
        <a class="dev" href="https://drivers.indilib.org/focusers"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>Focusers</a>
        <a class="dev" href="https://drivers.indilib.org/filter-wheels"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="6.5" r="2"/><circle cx="17.2" cy="13.7" r="2"/><circle cx="6.8" cy="13.7" r="2"/></svg>Filter wheels</a>
        <a class="dev" href="https://drivers.indilib.org/weather-stations"><svg viewBox="0 0 24 24"><path d="M7 17a4 4 0 1 1 .8-7.9A5 5 0 0 1 17.5 10 3.5 3.5 0 0 1 17 17Z"/><path d="M9 20v1M13 20v1"/></svg>Weather stations</a>
        <a class="dev" href="https://drivers.indilib.org/domes"><svg viewBox="0 0 24 24"><path d="M3 19h18M5 19v-6a7 7 0 0 1 14 0v6"/><path d="M11 6.2V12h2V6.2"/></svg>Domes</a>
        <a class="dev" href="https://drivers.indilib.org/rotators"><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v4h-4"/></svg>Rotators</a>
        <a class="dev" href="https://drivers.indilib.org/auxiliaries"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9zM9 2v2M15 2v2M9 20v2M15 20v2"/></svg>Auxiliary</a>
        <a class="dev" href="https://drivers.indilib.org/adaptive-optics"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M8 12h8"/></svg>Adaptive optics</a>
        <a class="dev" href="https://drivers.indilib.org/dustcaps"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M4 12h16"/></svg>Dust caps</a>
        <a class="dev" href="https://drivers.indilib.org/lightboxes"><svg viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="12" rx="2"/><path d="M8 10h8M8 14h8"/></svg>Light boxes</a>
        <a class="dev" href="https://drivers.indilib.org/observatory-controllers"><svg viewBox="0 0 24 24"><path d="M3 20h18M5 20V10l7-5 7 5v10"/><path d="M10 20v-5h4v5"/></svg>Observatory controllers</a>
      </div>
    </div>
  </section>

  <section id="clients" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head split">
        <div><p class="eyebrow">INDI clients</p><h2>Works with the software you already use</h2></div>
        <a class="more" href="/about/clients.html">All 27 clients</a>
      </div>
      <div class="clients">
        <span class="client"><img src="/img/kstars.webp" alt="">KStars / Ekos</span>
        <span class="client"><img src="/img/phd2.webp" alt="">PHD2</span>
        <span class="client"><img src="/img/stellarium.webp" alt="">Stellarium</span>
        <span class="client"><img src="/img/cartes-du-ciel.webp" alt="">Cartes du Ciel</span>
        <span class="client"><img src="/img/pixinsight.webp" alt="">PixInsight</span>
        <span class="client"><img src="/img/asiair.webp" alt="">ZWO ASIAIR</span>
        <span class="client"><img src="/img/ccdciel.webp" alt="">CCDCiel</span>
        <span class="client"><img src="/img/inde_allsky.webp" alt="">INDI AllSky</span>
        <span class="client plain">AstroPhoto Plus</span>
        <span class="client plain">Telescope.Touch</span>
        <span class="client plain">IPARCOS</span>
        <span class="client plain">HNSky</span>
        <span class="client plain">XEphem</span>
        <span class="client plain">OpenVLBI</span>
        <span class="client plain">NodeJS INDI Client</span>
      </div>
    </div>
  </section>

  <section class="band" id="install">
    <div class="wrap install">
      <div class="sec-head" style="margin:0">
        <p class="eyebrow">Download</p>
        <h2>Install INDI in a few commands</h2>
        <p class="lede">Pick your system. The commands install the INDI library and all third party drivers. <a href="/download.html">More systems and details</a>.</p>
        <div class="flatpak"><b>Using KStars?</b> The KStars Flatpak already includes INDI and all third party drivers, on every Linux distribution. You don't need anything else.</div>
      </div>
      <div>
        <div class="tabs" role="tablist" aria-label="Operating system">
          <button class="tab" role="tab" id="t-ubuntu" aria-selected="true" data-os="ubuntu">Ubuntu</button>
          <button class="tab" role="tab" id="t-pi" aria-selected="false" data-os="pi">Raspberry Pi</button>
          <button class="tab" role="tab" id="t-fedora" aria-selected="false" data-os="fedora">Fedora</button>
          <button class="tab" role="tab" id="t-arch" aria-selected="false" data-os="arch">Arch</button>
          <button class="tab" role="tab" id="t-mac" aria-selected="false" data-os="mac">macOS</button>
          <button class="tab" role="tab" id="t-src" aria-selected="false" data-os="src">Source</button>
        </div>
        <div class="term" role="tabpanel">
          <pre id="cmd"></pre>
          <div class="bar"><span id="cmd-note"></span><button type="button" id="copy">Copy</button></div>
        </div>
      </div>
    </div>
  </section>

  <section id="tutorials">
    <div class="wrap">
      <div class="sec-head split">
        <div><p class="eyebrow">Learn and develop</p><h2>Tutorials</h2></div>
        <a class="more" href="/tutorials.html">All tutorials</a>
      </div>
      <div class="tuts">
        <a class="tut" href="/tutorials/indi-on-windows.html"><img src="/img/windows.webp" alt=""><span class="tagline">Windows</span><h3>How to run INDI on Windows</h3></a>
        <a class="tut" href="/tutorials/time-lapse-with-python.html"><img src="/img/time-lapse-astrophotography-with-indi-python.webp" alt=""><span class="tagline">Python</span><h3>Time lapse astrophotography with INDI and Python</h3></a>
        <a class="tut" href="/tutorials/indi-python-programming.html"><img src="/img/indi-python.webp" alt=""><span class="tagline">Python</span><h3>INDI Python programming</h3></a>
        <a class="tut" href="/tutorials/remote-indi-drivers.html"><img src="/img/remote-indi-drivers.webp" alt=""><span class="tagline">Remote operation</span><h3>Remote INDI drivers</h3></a>
      </div>
    </div>
  </section>

  <section class="band" id="gallery">
    <div class="wrap">
      <div class="sec-head split">
        <div><p class="eyebrow">Captured with INDI</p><h2>From the community</h2><p class="lede">Images and setups shared by INDI users, with the gear behind each one.</p></div>
        <a class="more" href="/support/gallery.html">View the gallery</a>
      </div>
      <div class="shots">
        <figure class="shot s1"><img src="/img/ngc-7635.webp" alt="NGC 7635, the Bubble Nebula"><figcaption><b>NGC 7635 Bubble Nebula</b><span>RedCat51 · CEM25p · 533MC · 41×300s</span></figcaption></figure>
        <figure class="shot s2"><img src="/img/crescentnebula-fb.webp" alt="NGC 6888, the Crescent Nebula"><figcaption><b>NGC 6888 Crescent Nebula</b><span>Narrowband Ha · OIII · SII</span></figcaption></figure>
        <figure class="shot s3"><img src="/img/dragons-egg.webp" alt="A nebula imaged by a community member"><figcaption><b>Dragon's Egg</b><span>Shared in the INDI gallery</span></figcaption></figure>
        <figure class="shot s4"><img src="/img/m51062124z103asi533mmcroppedversion2.webp" alt="M51, the Whirlpool Galaxy"><figcaption><b>M51 Whirlpool</b><span>Z103 · ASI533MM Pro · 13 h RGB</span></figcaption></figure>
        <figure class="shot s5"><img src="/img/ngc5907-cn.webp" alt="NGC 5907, the Splinter Galaxy"><figcaption><b>NGC 5907 Splinter Galaxy</b><span>Draco · edge-on spiral</span></figcaption></figure>
        <figure class="shot s6"><img src="/img/m-45.webp" alt="M45, the Pleiades"><figcaption><b>M45 Pleiades</b><span>RedCat51 · 533MC · 10×300s · Siril</span></figcaption></figure>
      </div>
    </div>
  </section>

  <section id="community">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Community and support</p><h2>Ask a question, share a log, help others</h2></div>
      <div class="community">
        <div class="forum">
          <header>
            <div><h3>INDI Forum</h3><p>Our community forum, now on Discourse. Old forum links redirect to the same topic.</p></div>
            <a class="btn primary small" href="https://forum.indilib.org">Open forum.indilib.org</a>
          </header>
          <ul class="topics" id="topics" aria-live="polite">
            <li class="loading"><span>Loading the latest topics…</span></li>
          </ul>
          <p class="note" id="topics-note">Latest topics from forum.indilib.org.</p>
        </div>
        <div class="channels">
          <a class="channel" href="/support/faq.html"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01"/></svg><div><h3>FAQ</h3><p>Answers to the most common setup and connection questions.</p></div></a>
          <a class="channel" href="https://github.com/indilib/indi/issues"><svg viewBox="0 0 24 24"><path d="M8 2v4M16 2v4M6 8h12v4a6 6 0 0 1-12 0Z"/><path d="M3 13h3M18 13h3M4 19l3-2M20 19l-3-2"/></svg><div><h3>Report a bug</h3><p>File an issue on GitHub. Attach logs as explained in the logs guide.</p></div></a>
          <a class="channel" href="/support/logs-submission.html"><svg viewBox="0 0 24 24"><path d="M14 3H6v18h12V7Z"/><path d="M14 3v4h4M9 13l2 2-2 2M13 17h3"/></svg><div><h3>Submit logs</h3><p>How to collect KStars and INDI logs when you ask for help.</p></div></a>
          <a class="channel donate" href="https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&amp;hosted_button_id=HBWELZ79SSSC6&amp;source=url"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"/></svg><div><h3>Support INDI</h3><p>INDI is built by volunteers. Donations keep the servers and the forum running.</p></div></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // ---------- Install commands, copied from the current download pages ----------
  var OS = {
    ubuntu: { note: "Ubuntu 22.04 and later", lines: ["# Add the INDI repository", "$ sudo apt-add-repository ppa:mutlaqja/ppa", "$ sudo apt-get update", "", "# Ubuntu 22.04 to 24.04", "$ sudo apt-get install indi-full gsc", "", "# Ubuntu 26.04 and later", "$ sudo apt-get install indi-3rdparty-drivers gsc"] },
    pi: { note: "Raspberry Pi OS / Debian Trixie (arm64)", lines: ["# Add the Astroberry repository", "$ curl -fsSL https://astroberry.io/debian/astroberry.asc | sudo gpg --dearmor -o /etc/apt/keyrings/astroberry.gpg", "$ curl -fsSL https://astroberry.io/debian/astroberry.sources | sudo tee /etc/apt/sources.list.d/astroberry.sources", "$ sudo apt update", "", "$ sudo apt install indi-3rdparty-drivers gsc"] },
    fedora: { note: "Fedora 31 and later, from Copr", lines: ["$ sudo dnf copr enable xsnrg/libindi-bleeding", "$ sudo dnf copr enable xsnrg/indi-3rdparty-bleeding", "", "# Library with basic drivers", "$ sudo dnf install indi indi-libs", "", "# All drivers", "$ sudo dnf install indi-*"] },
    arch: { note: "Arch Linux and derivatives", lines: ["$ sudo pacman -S --needed libindi", "", "# Third party drivers come from the AUR.", "# See the Arch download page for the package list."] },
    mac: { note: "macOS", lines: ["# INDI ships inside the KStars macOS release.", "# Download KStars (stable or nightly) and open the .dmg.", "", "# Or build libindi from source (see the Source tab)."] },
    src: { note: "Any Linux or macOS", lines: ["$ git clone --depth 1 https://github.com/indilib/indi.git", "$ cd indi && mkdir build && cd build", "$ cmake -DCMAKE_INSTALL_PREFIX=/usr ..", "$ make -j4 && sudo make install"] }
  };
  var esc = function (s) { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;"); };
  var cmd = document.getElementById("cmd"), note = document.getElementById("cmd-note"), current = "ubuntu";
  function showOS(os) {
    current = os;
    cmd.innerHTML = OS[os].lines.map(function (l) {
      if (l.charAt(0) === "#") return '<span class="cm">' + esc(l) + "</span>";
      if (l.charAt(0) === "$") return '<span class="pr">$ </span>' + esc(l.slice(2));
      return esc(l);
    }).join("\n");
    note.textContent = OS[os].note;
    document.querySelectorAll(".tab").forEach(function (t) { t.setAttribute("aria-selected", t.dataset.os === os ? "true" : "false"); });
  }
  document.querySelectorAll(".tab").forEach(function (t) { t.addEventListener("click", function () { showOS(t.dataset.os); }); });
  showOS("ubuntu");
  var copy = document.getElementById("copy");
  function selectCmd() { var r = document.createRange(); r.selectNodeContents(cmd); var s = getSelection(); s.removeAllRanges(); s.addRange(r); copy.textContent = "Press Ctrl+C"; }
  copy.addEventListener("click", function () {
    var text = OS[current].lines.filter(function (l) { return l.charAt(0) === "$"; }).map(function (l) { return l.slice(2); }).join("\n");
    try {
      navigator.clipboard.writeText(text).then(function () { copy.textContent = "Copied"; setTimeout(function () { copy.textContent = "Copy"; }, 1600); }, selectCmd);
    } catch (e) { selectCmd(); }
  });

  // ---------- Latest forum topics, read from Discourse in the browser ----------
  (async () => {
    const list = document.getElementById("topics");
    const note = document.getElementById("topics-note");
    if (!list || !note) return;
    const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    try {
      const res = await fetch("https://forum.indilib.org/latest.json", { headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      const cats = new Map<number, string>((data.categories ?? []).map((c: { id: number; name: string }) => [c.id, c.name]));
      const topics = (data.topic_list?.topics ?? []).filter((t: { pinned: boolean }) => !t.pinned).slice(0, 5);
      if (!topics.length) throw new Error("empty");
      list.innerHTML = topics.map((t: { slug: string; id: number; title: string; posts_count: number; category_id: number }) =>
        `<li><a href="https://forum.indilib.org/t/${t.slug}/${t.id}">${esc(t.title)}</a><span class="n">${t.posts_count - 1} replies</span><span class="cat">${esc(cats.get(t.category_id) ?? "")}</span></li>`).join("");
    } catch {
      list.innerHTML = '<li class="loading"><span>The latest topics could not be loaded here. <a href="https://forum.indilib.org">Visit the forum</a> to read them.</span></li>';
      note.hidden = true;
    }
  })();
</script>
