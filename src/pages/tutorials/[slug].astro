---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { topicName } from "../../data/topics";
import { sortedTutorials, minutes, tutorialUrl, type Tutorial } from "../../data/tutorials";
import ArticleEnhance from "../../components/ArticleEnhance.astro";
import "../../styles/tutorials.css";

export async function getStaticPaths() {
  const all = await sortedTutorials();
  return all.map((t, i) => ({
    params: { slug: t.id },
    props: { t, prev: all[i - 1], next: all[i + 1], related: all.filter((o) => o.data.topic === t.data.topic && o.id !== t.id).slice(0, 3) },
  }));
}

interface Props { t: Tutorial; prev?: Tutorial; next?: Tutorial; related: Tutorial[] }
const { t, prev, next, related } = Astro.props;
const { Content, headings } = await render(t);
const toc = headings.filter((h) => h.depth === 2);
const editUrl = `https://github.com/indilib/indi-website/edit/main/src/content/tutorials/${t.id}/index.md`;
// Show the cover on top only when the article doesn't already include that image
const coverName = t.data.cover?.src.split("/").pop()!.split(/[.?]/)[0];
const showCover = t.data.cover && !(t.body ?? "").includes(`./${coverName}.`);
const date = t.data.date?.toLocaleDateString("en-US", { year: "numeric", month: "long" });
---
<Base title={t.data.title} description={t.data.description}>
  <div class="wrap a-head">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span><a href="/tutorials.html">Tutorials</a></span><span>{topicName(t.data.topic)}</span></nav>
    <h1>{t.data.title}</h1>
    <p class="lede">{t.data.description}</p>
    <div class="a-meta">
      <span class="by"><i>{(t.data.author ?? "I").charAt(0).toUpperCase()}</i>{t.data.author ?? "INDI community"}</span>
      {date && <span>{date}</span>}
      {t.data.video ? <span>Video</span> : <span>{minutes(t)} min read</span>}
      {t.data.drivers?.map((d) => <span>Driver <code>{d}</code></span>)}
      <a href={editUrl}>Edit on GitHub</a>
    </div>
  </div>
  {showCover && t.data.cover && <div class="wrap"><Image class="cover" src={t.data.cover} alt="" width={1180} /></div>}

  <div class="wrap a-grid">
    <article class="prose">
      <Content />

      <div class="a-end">
        <div class="ask"><div><b>Questions about this tutorial?</b><span>Ask on the forum. Someone who has done it will answer.</span></div><a class="btn primary small" href="https://forum.indilib.org">Ask on the forum</a></div>
        <nav class="pager" aria-label="More tutorials">
          {prev ? <a href={tutorialUrl(prev)}><small>← Previous</small>{prev.data.title}</a> : <span></span>}
          {next && <a href={tutorialUrl(next)}><small>Next →</small>{next.data.title}</a>}
        </nav>
        <p class="edit"><span>Found a mistake? This page is a Markdown file.</span><a href={editUrl}>Edit this page on GitHub</a></p>
      </div>
    </article>

    <aside class="aside">
      {toc.length > 1 && (
        <details class="toc" id="toc" open>
          <summary>On this page</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
      {related.length > 0 && (
        <div class="side-box">
          <h4>More in {topicName(t.data.topic)}</h4>
          <ul>{related.map((r) => <li><a href={tutorialUrl(r)}>{r.data.title}</a></li>)}</ul>
        </div>
      )}
    </aside>
  </div>
</Base>

<ArticleEnhance />
